{
  "name": "youtube-to-your-format",
  "version": "1.0.5",
  "main": "main/main.mjs",
  "description": "youtube-to-your-format",
  "author": "Bobo",
  "scripts": {
    "dev": "concurrently -n \"NEXT,ELECTRON\" -c \"yellow,blue\" --kill-others \"next dev\" \"electron .\"",
    "dev_electron": "electron .",
    "build": "next build && electron-builder",
    "build_next": "next build",
    "build_electron": "electron-builder",
    "postinstall": "node scripts/download-ffmpeg.js",
    "start": "serve -s out",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.example.youtubetoyoutformat",
    "files": [
      "main/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "out/",
        "to": "out/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "resources/**/*",
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/lodash": "^4.17.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-serve": "^2.0.0",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "i18next": "^26.4.2",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-joyride": "^3.2.0",
    "react-redux": "^9.3.0",
    "tsconfig-paths": "^4.2.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "http-server": "^14.1.1",
    "postcss": "^8.5.29",
    "sass": "^1.105.1",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
